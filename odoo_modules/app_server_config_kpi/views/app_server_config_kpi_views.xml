<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_app_server_config_form_users" model="ir.ui.view">
        <field name="name">app.server.config.form.users</field>
        <field name="model">app.server.config</field>
        <field name="inherit_id" ref="app_server_config.view_app_server_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <separator string="Users"/>
                <!-- The users EMBEDDED here, not a button that navigates away.
                     A <widget> is the only way to put an OWL component inside a
                     form: this layout (login under the name, country dropdown
                     above a +91 prefix box) cannot be built from fields.

                     Same component the Users menu opens, so the two can never
                     look different. It writes through kra_kpi_module's existing
                     /kpi_user_access/* routes, so this and Login Management
                     (Non-odoo) edit the same res.users fields. -->
                <widget name="app_server_users"/>
            </xpath>
        </field>
    </record>

    <!-- Our own Users screen. An OWL component, because the layout (login under
         the name, country dropdown above a +91 prefix box) cannot be expressed
         in a list view.

         It writes through kra_kpi_module's EXISTING /kpi_user_access/* routes,
         so this and Login Management (Non-odoo) edit the same res.users fields —
         a change in either shows in the other. The UI is duplicated; the data
         deliberately is not. -->
    <record id="action_app_server_users" model="ir.actions.client">
        <field name="name">Users</field>
        <field name="tag">app_server_users</field>
    </record>

    <menuitem id="menu_app_server_users"
              name="Users"
              parent="app_server_config.menu_app_server_root"
              action="action_app_server_users"
              sequence="20"
              groups="base.group_system"/>

</odoo>
