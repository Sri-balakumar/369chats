<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_app_server_config_list" model="ir.ui.view">
        <field name="name">app.server.config.list</field>
        <field name="model">app.server.config</field>
        <field name="arch" type="xml">
            <!-- NOT editable="bottom". An editable list makes "New" add an
                 inline row, so the form — which is where the URL is entered,
                 the databases load and the users are listed — is never opened.
                 New must open the page. -->
            <list string="App Servers">
                <field name="app_key"/>
                <field name="name"/>
                <field name="client_url"/>
                <field name="client_db"/>
                <!-- Read-only: switching is done by the button beside it, which
                     reloads. An editable toggle here writes one row and the
                     client re-reads only that row, so the servers this switches
                     OFF carried on showing as on until a manual refresh. -->
                <field name="is_live" widget="boolean_toggle" readonly="1"/>
                <!-- Confirmed, because it points every phone somewhere else and
                     signs everyone out on their next launch. -->
                <button name="action_make_live" type="object"
                        string="Make this the live one" icon="fa-toggle-on"
                        class="btn-link" invisible="is_live"
                        confirm="Point the apps at this server? The one currently active will be switched off, and anyone signed in will be asked to sign in again next time they open the app."/>
            </list>
        </field>
    </record>

    <record id="view_app_server_config_form" model="ir.ui.view">
        <field name="name">app.server.config.form</field>
        <field name="model">app.server.config</field>
        <field name="arch" type="xml">
            <form string="App Server">
                <sheet>
                    <div class="oe_title">
                        <label for="app_key"/>
                        <h1><field name="app_key" placeholder="369chats"/></h1>
                    </div>
                    <group>
                        <group string="What devices should use">
                            <!-- Leaving this field fetches that server's
                                 databases; no button to press. -->
                            <field name="client_url" placeholder="https://odoo.example.com"/>
                            <field name="db_options" invisible="1"/>
                            <field name="db_failed" invisible="1"/>
                            <!-- Result of the last lookup: red when the server
                                 could not be reached or offered nothing, so a
                                 failure is still visible after the popup has
                                 been dismissed. -->
                            <div colspan="2" class="text-danger fw-bold"
                                 invisible="not db_failed">
                                <i class="fa fa-exclamation-triangle me-1"/>
                                <field name="db_status" nolabel="1" readonly="1"
                                       class="d-inline text-danger fw-bold"/>
                            </div>
                            <div colspan="2" class="text-success"
                                 invisible="db_failed or not db_status">
                                <i class="fa fa-check me-1"/>
                                <field name="db_status" nolabel="1" readonly="1"
                                       class="d-inline text-success"/>
                            </div>
                            <!-- ALWAYS visible. It used to be hidden until a
                                 fetch had succeeded, which meant a new record
                                 showed only the text box below — so the field
                                 looked like something you type, which is the
                                 opposite of the intent. It is the primary
                                 control; it simply has nothing in it until a
                                 URL has been entered. -->
                            <field name="client_db_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="Select your database"/>
                            <!-- The value the app endpoint actually receives.
                                 Read-only once the dropdown has supplied it;
                                 editable when a fetch found nothing, which is
                                 the real case of a server running with
                                 list_db = False. -->
                            <field name="client_db" placeholder="sales_test"
                                   readonly="db_options != False"/>
                        </group>
                        <group string="Admin">
                            <field name="name" placeholder="369Chats mobile app"/>
                            <!-- Read-only here too, switched by the button, so
                                 the form and the list behave the same way. -->
                            <field name="is_live" widget="boolean_toggle" readonly="1"/>
                            <button name="action_make_live" type="object"
                                    string="Make this the live one"
                                    icon="fa-toggle-on" class="btn-link"
                                    invisible="is_live"
                                    confirm="Point the apps at this server? The one currently active will be switched off, and anyone signed in will be asked to sign in again next time they open the app."/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Apps ask this server for their address on every cold start, so changing
                        the URL or database here moves every device by itself — no rebuild and no
                        re-setup. Anyone already signed in is asked to sign in again next time they
                        open the app, so keep the old server reachable for a while after switching.
                        <br/>
                        Leave a field empty to answer with this server's own address or database.
                        The app key is what the installed app sends: renaming it breaks every copy
                        already out there until they are rebuilt.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_app_server_config" model="ir.actions.act_window">
        <field name="name">App Servers</field>
        <field name="res_model">app.server.config</field>
        <field name="view_mode">list,form</field>
        <!-- active_test kept as a belt-and-braces: `active` is now unused and
             always true, so nothing should ever be hidden, but this guarantees
             it even if a row is archived by some other route. The toggle the
             admin actually uses is is_live. -->
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tell a mobile app where to connect</p>
            <p>
                One row per app. The app sends its key (for example
                <b>369chats</b>) and gets back the URL and database it should use.
            </p>
        </field>
    </record>

    <!-- A TOP-LEVEL menu, not Settings → Technical. Technical is gated on the
         "Technical Features" group, i.e. developer mode has to be switched on to
         reach it — and pointing apps at a new server is the routine admin task
         this module exists for, not a developer chore.

         The access rules already limit the records to system administrators, so
         the menu carries the same group and nothing is loosened by moving it. -->
    <menuitem id="menu_app_server_root"
              name="App Servers"
              sequence="47"
              groups="base.group_system"/>

    <!-- A root menu needs a CHILD carrying the action: an action placed directly
         on a root menu does not open from the Apps grid.

         Named "Servers", not "App Servers" — the root is already called that, and
         two entries with the same label read as a duplicate rather than as an
         app and the page inside it. -->
    <menuitem id="menu_app_server_config"
              name="Servers"
              parent="menu_app_server_root"
              action="action_app_server_config"
              sequence="10"
              groups="base.group_system"/>

</odoo>
